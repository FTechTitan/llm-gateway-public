# Generate a real .env with fresh secrets:  node tools/generar-env.mjs http://localhost:8740
# This file only documents the variables. Never commit a real .env.

PUBLIC_URL=http://localhost:8740
BIND_IP=127.0.0.1                 # 127.0.0.1 = local only; use a private-network IP to expose it there
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-40-hex-chars
ANON_KEY=<jwt role=anon signed with JWT_SECRET>
SERVICE_ROLE_KEY=<jwt role=service_role signed with JWT_SECRET>
GATEWAY_ENC_KEY=<32 random bytes, base64>   # encrypts provider keys at rest (AES-256-GCM)
GATEWAY_MASTER_KEY=tfm_<random>             # superadmin key for /admin

# Optional: daily e-mail report
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORTE_PARA=you@example.com
REPORTE_HORA=8

# Optional: web push for the panel (web-push VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Subscription pass-through mode (experimental, OFF by default; read your provider's terms first)
SUSCRIPCION_HABILITADA=false
# Retry model when OpenAI rejects a request with its content filter; empty = disabled
GW_RESPALDO_FILTRO=
